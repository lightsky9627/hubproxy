[Unit]
Description=HubProxy Container Registry Accelerator & Proxy
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/etc/hubproxy
ExecStartPre=/bin/mkdir -p /etc/hubproxy/data
ExecStart=/usr/local/bin/hubproxy
Restart=always
RestartSec=5
LimitNOFILE=65535
ReadWritePaths=/etc/hubproxy

# 安全限制
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
