#!/sbin/openrc-run

name="hubproxy"
description="HubProxy Container Registry Accelerator & Proxy"

directory="/etc/hubproxy"
command="/usr/local/bin/hubproxy"
command_background="true"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/hubproxy.log"
error_log="/var/log/hubproxy.err"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath -d -m 0755 -o root:root /etc/hubproxy
    checkpath -d -m 0755 -o root:root /etc/hubproxy/data
}
